# Base de données : Postgres auto-hébergé (VPS), lu par le driver `pg` (lib/db.ts).
# Vercel Postgres n'existe plus — les stores ont été transférés à Neon fin 2024,
# et `@vercel/postgres` n'est plus maintenu.
DATABASE_URL=postgres://user:password@host:5432/base

# Cert self-signed côté VPS : la connexion est chiffrée sans vérifier la chaîne.
# Mettre `disable` pour une base locale sans TLS.
PGSSL=

# Token secret pour protéger les endpoints d'ingestion (/api/update, /api/carte…)
API_SECRET_TOKEN=ton-token-secret-ici
