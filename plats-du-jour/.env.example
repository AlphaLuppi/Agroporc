# Facebook credentials (pour Le Truck Muche)
# Le token Claude est lu automatiquement depuis le macOS Keychain
# (Claude Code doit être connecté)
FACEBOOK_EMAIL=votre@email.com
FACEBOOK_PASSWORD=votre_mot_de_passe

# Optionnel : profil sportif pour l'agent diététicien
SPORT_PROFILE=musculation
DAILY_CALORIES_TARGET=2500

# Optionnel : override manuel du token Claude (si pas de Keychain disponible)
# ANTHROPIC_API_KEY=sk-ant-...

# Giphy API (pour les GIFs dans les commentaires)
# Créer une app sur https://developers.giphy.com/
GIPHY_API_KEY=votre_cle_giphy

# Vercel (publication automatique des PDJ)
VERCEL_API_URL=https://agroporc.vercel.app
API_SECRET_TOKEN=votre_token_secret

# Images IA des plats (POC) — tout est optionnel : sans rien, Pollinations anonyme
# (gratuit, 1 image / 45 s, petit logo Pollinations laissé visible + crédit affiché).
# Cloudflare Workers AI (flux-1-schnell, compte gratuit, ~120 images/jour) :
#   jeton « Workers AI » + Account ID sur https://dash.cloudflare.com
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# AI Horde (Juggernaut XL, compte gratuit sur https://aihorde.net/register) :
# AIHORDE_API_KEY=
# PDJ_IMAGES_HORDE_ANONYME=1        # Horde sans compte (≈ 15-20 min / image)
# PDJ_IMAGES_FOURNISSEURS=cloudflare,horde,pollinations   # ordre forcé
# PDJ_IMAGES=off                    # coupe la génération (run + commande images)
# PDJ_IMAGES_BUDGET_RUN=150         # s accordées dans le run jour/semaine
# PDJ_IMAGES_BUDGET=1500            # s accordées à `python main.py images`
